rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Coleção principal dos PAFs (e dos registros de famílias desistentes,
    //      que ficam na mesma coleção com tipo:"desistencia") ----
    match /planos_acompanhamento_familiar/{docId} {
      allow read, write: if request.auth != null;

      // Alternativa: se este MESMO projeto/link for usado por MAIS DE UM
      // CRAS, troque a linha acima por estas duas, para que um técnico só
      // veja/edite os PAFs do seu próprio CRAS. Para isso funcionar, cada
      // usuário precisa ter o campo "cras" gravado como custom claim (veja
      // script-admin-criar-usuario.js), e o valor de "crasNome" no formulário
      // precisa ser escolhido de uma lista fixa, não digitado livremente.
      //
      // allow read, write: if request.auth != null
      //   && request.auth.token.cras == resource.data.crasNome;
      // allow create: if request.auth != null
      //   && request.auth.token.cras == request.resource.data.crasNome;
    }

    // ---- Trilha de auditoria (quem criou/excluiu/registrou desistência e
    //      quando) — usada pela função registrarAuditoria() do app.js.
    //      Só permite criar registros (nunca editar ou apagar), para que o
    //      histórico não possa ser adulterado por quem tem acesso ao app. ----
    match /auditoria/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
